{
  "name": "varchar-playground",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "In-browser playground for the varchar engine, hosted on Cloudflare Workers",
  "scripts": {
    "build:wasm": "wasm-pack build wasm --release --target web --no-pack --out-name varchar --out-dir ../src/wasm",
    "build": "pnpm run build:wasm && vite build",
    "dev": "pnpm run build:wasm && vite",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "sync": "catppuccin-neu-sync src/vendor"
  },
  "dependencies": {
    "preact": "^10.28.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "catppuccin-neu": "github:BalajiLeninrajan/catppuccin-neu#v0.1.3",
    "vite": "^7.3.1",
    "wrangler": "^4"
  }
}
